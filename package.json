{
  "name": "workerdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A terminal workspace for profile-based native coding harness orchestration",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "workerdeck": "bin/workerdeck.mjs"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "workerdeck": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:host": "tsx server/index.ts",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "typecheck:host": "tsc --noEmit",
    "test:web": "tsx --test web/test/*.test.ts",
    "test:host": "tsx --test test/server*.test.ts",
    "host": "node --import tsx server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.300",
    "@opencode-ai/sdk": "1.19.0",
    "fflate": "0.8.3",
    "ink": "8.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wrap-ansi": "10.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
