# Load explicitly: node --env-file=.env --import tsx src/cli.tsx run
# Keep keys on your machine. Profile exports never read this file.
# Optional if your personal native Claude login is active (claude auth login).
ANTHROPIC_API_KEY=

# OpenCode uses its native authenticated/configured model by default.
# Set these to an actual provider/model ID available in your OpenCode setup.
SUBHARNESS_MODEL_ORCHESTRATOR=
SUBHARNESS_MODEL_IMPLEMENT=
SUBHARNESS_MODEL_REVIEW=

# Claude accepts its native model IDs/aliases.
SUBHARNESS_MODEL_UI=sonnet

# Optional native executable path, especially for custom Windows installations.
SUBHARNESS_OPENCODE_BIN=
SUBHARNESS_CLAUDE_BIN=
SUBHARNESS_CODEX_BIN=
# Optional native Codex model ID; empty uses its configured default.
SUBHARNESS_MODEL_CODEX=

# OCI image store shared by projects; empty uses ~/.subharness/images.
SUBHARNESS_IMAGE_STORE=
# ORAS CLI 1.3+ is needed only for registry push/pull.
SUBHARNESS_ORAS_BIN=
# Optional file or HTTPS metadata catalog for search.
SUBHARNESS_CATALOG=
